{
  "name": "pets-driven",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:playground": "vite --open /playground.html",
    "dev:tauri": "vite --mode tauri",
