{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pets Driven",
  "identifier": "com.petsdriven.desktop",
  "build": {
    "beforeDevCommand": "node ../../scripts/stage-cli.mjs && pnpm run dev:tauri",
    "beforeBuildCommand": "pnpm run build:playground && node ../../scripts/stage-cli.mjs",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pets Driven",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.codex/pets/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "../../../plugins": "plugins",
      "../../../pets": "pets"
    },
    "externalBin": ["binaries/pdd"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQzg3RThDRENEMzcwREYKUldUZmNOUGNqSDdJb2xQb3RQTE1EazZLN2dSR2VSVVJYc045WEJIaGYwUW9PWllzKzBKZXU1QncK",
      "endpoints": [
        "https://github.com/young1the/pets-driven/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
