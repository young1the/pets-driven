# URL the CTA's "source" link points at.
NEXT_PUBLIC_GITHUB_URL=https://github.com/young1the/pets-driven

# Installer the CTA button downloads. Optional — lib/site.ts falls back to the
# latest-release asset URL when unset.
NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/young1the/pets-driven/releases/latest/download/PetsDriven-windows-x64-setup.exe

# Canonical origin for canonical links, hreflang, Open Graph, and the sitemap.
# Optional — lib/site.ts falls back to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://pets-driven.xyz
