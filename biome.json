{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true
  },

  "assist": {
    "enabled": true
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },

  "files": {
    "includes": ["apps/**", "packages/**", "!**/dist", "!**/build", "!**/.next", "!**/coverage"]
  },

  "overrides": [
    {
      "includes": [
        "packages/pet-engine/src/**",
        "packages/design-system/src/**",
        "packages/i18n/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/**"],
                    "message": "Platform-agnostic packages must not depend on Tauri. Keep native access in apps/desktop (behind DesktopGateway)."
                  },
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "Platform-agnostic packages must not depend on Node built-ins. This code must run unchanged in the browser playground."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
