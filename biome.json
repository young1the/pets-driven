{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },

  "files": {
    "includes": ["apps/**", "packages/**", "!**/dist", "!**/build", "!**/.next", "!**/coverage"]
  }
}
