            "statusMessage": "Notifying pets-driven"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" forward-codex Stop",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" forward-codex Stop",
