    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" forward-codex UserPromptSubmit",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" forward-codex UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "Notifying pets-driven"
          }
        ]
      }
    ],
    "PermissionRequest": [
