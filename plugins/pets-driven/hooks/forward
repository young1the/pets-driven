#!/usr/bin/env bash
# Forward Claude Code hook events to the pets-driven desktop app.
#
# Modes:
#   forward                          read hook JSON from stdin, POST it unchanged
#   forward options                  print the hatchable assets and personality
#                                    presets the app accepts
#   forward list                     print every pet in the app's state
#   forward hatch ASSET NAME PRESET [CWD]
#                                    POST a create request (this script builds the
#                                    JSON so paths are escaped safely) and print
#                                    the response
#   forward bind PET_ID [CWD]        bind that pet to CWD (default $PWD)
#   forward unbind PET_ID            detach that pet from its folder (cwd -> null)
#   forward --self-check             assert the synthesized bodies, then exit
#
# The desktop app is the only reader of pets-driven state and pet asset folders:
# every mode here goes through its HTTP ingress rather than touching those files,
# so an agent never has to know where they live on disk.
#
# ponytail: the ingress URLs are coupled to CLAUDE_HOOK_INGRESS_PORT (43187)
# and the ingress paths in apps/desktop/src-tauri/src/claude_hook_ingress.rs
# -- change both sides if the port or paths move.

# PETS_DRIVEN_INGRESS_ORIGIN lets the tests aim at a closed port to exercise the
# "app not running" answer; nothing sets it in normal use.
INGRESS_ORIGIN="${PETS_DRIVEN_INGRESS_ORIGIN:-http://127.0.0.1:43187}"
INGRESS_URL="$INGRESS_ORIGIN/claude-hook"

post() {
  # -s silent, -m 2 caps the wait so a stopped app never blocks the agent.
  # The body must travel via stdin, not argv: on Windows the bash -> curl.exe
  # argv boundary re-encodes non-ASCII (e.g. Korean OneDrive paths) into the
  # ANSI codepage, and the ingress then rejects the body as invalid UTF-8.
  printf '%s' "$1" | curl -s -m 2 -X POST "$INGRESS_URL" \
    -H "Content-Type: application/json" --data-binary @- >/dev/null 2>&1
}

# A stopped desktop app is a normal state, not a fault: the plugin can be
# installed long before the app is first opened. Answering with this instead of
# curl's connection error keeps the agent from reporting a scary failure, while
# still telling it apart from a rejection (which comes back as the app's own
# {"ok":false,"error":...}).
APP_NOT_RUNNING='{"ok":false,"error":"app-not-running","message":"The pets-driven desktop app is not running."}'

request() {
  # Authoritative call: print the response body. A connection failure is
  # reported as the structured app-not-running answer above and still exits 0,
  # so an unopened app never surfaces as a command error.
  local path="$1"
  shift
  local response
  if ! response="$(printf '%s' "${1-}" | curl -s -m 5 -X POST "$INGRESS_ORIGIN$path" \
    -H "Content-Type: application/json" --data-binary @- 2>/dev/null)"; then
    printf '%s' "$APP_NOT_RUNNING"
    return 0
  fi
  printf '%s' "$response"
  return 0
}

json_escape() {
  # Escape backslashes and double quotes so a path embeds safely in JSON.
  local escaped="${1//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  printf '%s' "$escaped"
}

# Convert a path to a real Windows path (D:\...) when cygpath is available, so
# the desktop app can open it as a terminal working directory. Falls back to the
# raw value off-Windows.
to_windows_path() {
  cygpath -w "$1" 2>/dev/null || printf '%s' "$1"
}

hatch_body() {
  local cwd
  cwd="$(to_windows_path "${4:-$PWD}")"
  printf '{"cwd":"%s","assetId":"%s","name":"%s","personalityId":"%s"}' \
    "$(json_escape "$cwd")" \
    "$(json_escape "$1")" \
    "$(json_escape "$2")" \
    "$(json_escape "$3")"
}

bind_body() {
  printf '{"petId":"%s","cwd":"%s"}' \
    "$(json_escape "$1")" \
    "$(json_escape "$(to_windows_path "${2:-$PWD}")")"
}

unbind_body() {
  # An explicit null is the "detach this pet from its folder" signal; omitting
  # the field would leave the current binding untouched.
  printf '{"petId":"%s","cwd":null}' "$(json_escape "$1")"
}

summary_body() {
  printf '{"hook_event_name":"%s","cwd":"%s","summary":"%s"}' \
    "$(json_escape "$1")" \
    "$(json_escape "$PWD")" \
    "$(json_escape "$2")"
}

self_check() {
  # A Windows path's backslashes must be escaped so the request JSON does not
  # inject control characters (a raw "\r" parses to a carriage return).
  local hatch
  hatch="$(hatch_body "cato" "Rex" "playful" 'C:\a\b')"
  case "$hatch" in
    *'\\a\\b'*) ;;
    *) echo "FAIL: hatch path not escaped: $hatch" >&2; exit 1 ;;
  esac

  local bind
  bind="$(bind_body "pet-1" 'C:\a\b')"
  case "$bind" in
    *'\\a\\b'*) ;;
    *) echo "FAIL: bind path not escaped: $bind" >&2; exit 1 ;;
  esac

  # The detach signal has to be a bare JSON null -- "null" as a string would
  # read as a folder literally named null.
  local unbind
  unbind="$(unbind_body "pet-1")"
  case "$unbind" in
    *'"cwd":null'*) ;;
    *) echo "FAIL: unbind body should send a null cwd: $unbind" >&2; exit 1 ;;
  esac

  local summary
  summary="$(summary_body "Stop" 'He said "hi" and left')"
  case "$summary" in
    *'"hook_event_name":"Stop"'*) ;;
    *) echo "FAIL: missing hook_event_name in: $summary" >&2; exit 1 ;;
  esac
  case "$summary" in
    *"$(json_escape "$PWD")"*) ;;
    *) echo "FAIL: cwd not embedded in: $summary" >&2; exit 1 ;;
  esac
  case "$summary" in
    *'\"hi\"'*) ;;
    *) echo "FAIL: summary text not escaped: $summary" >&2; exit 1 ;;
  esac

  echo "self-check passed"
  exit 0
}

case "$1" in
  --self-check) self_check ;;
  # Read-only lookups: the app answers from its own state, so the agent never
  # reads the state file or a pet asset folder itself.
  options) request /pets-driven/options; exit $? ;;
  list) request /pets-driven/list; exit $? ;;
  hatch)
    # Authoritative create: show the response, which tells "app not running"
    # apart from a rejection (e.g. the folder is already occupied).
    # JSON is built here from plain args so the agent never has to escape a path.
    shift
    request /pets-driven/hatch "$(hatch_body "$@")"
    exit $?
    ;;
  bind)
    shift
    request /pets-driven/pet/update "$(bind_body "$@")"
    exit $?
    ;;
  unbind)
    shift
    request /pets-driven/pet/update "$(unbind_body "$@")"
    exit $?
    ;;
  summary)
    shift
    post "$(summary_body "$@")"
    ;;
  *) post "$(cat)" ;;
esac

exit 0
