#!/usr/bin/env bash
# Forward Claude Code hook events to the pets-driven desktop app.
#
# Modes:
#   forward                          read hook JSON from stdin, POST it unchanged
#   forward attach                   synthesize a Notification ping for $PWD
#   forward hatch ASSET NAME PRESET [CWD]
#                                    POST a create request (this script builds the
#                                    JSON so paths are escaped safely), print the
#                                    response, propagate failure
#   forward --self-check             assert the synthesized bodies, then exit
#
# ponytail: the ingress URLs are coupled to CLAUDE_HOOK_INGRESS_PORT (43187)
# and the ingress paths in apps/desktop/src-tauri/src/claude_hook_ingress.rs
# -- change both sides if the port or paths move.

INGRESS_URL="http://127.0.0.1:43187/claude-hook"
HATCH_URL="http://127.0.0.1:43187/pets-driven/hatch"

post() {
  # -s silent, -m 2 caps the wait so a stopped app never blocks the agent.
  curl -s -m 2 -X POST "$INGRESS_URL" \
    -H "Content-Type: application/json" --data-binary "$1" >/dev/null 2>&1
}

json_escape() {
  # Escape backslashes and double quotes so a path embeds safely in JSON.
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

attach_body() {
  printf '{"hook_event_name":"Notification","cwd":"%s","message":"Agent attached"}' \
    "$(json_escape "$PWD")"
}

# Convert a path to a real Windows path (D:\...) when cygpath is available, so
# the desktop app can open it as a terminal working directory. Falls back to the
# raw value off-Windows.
to_windows_path() {
  cygpath -w "$1" 2>/dev/null || printf '%s' "$1"
}

hatch_body() {
  local cwd
  cwd="$(to_windows_path "${4:-$PWD}")"
  printf '{"cwd":"%s","assetId":"%s","name":"%s","personalityId":"%s"}' \
    "$(json_escape "$cwd")" \
    "$(json_escape "$1")" \
    "$(json_escape "$2")" \
    "$(json_escape "$3")"
}

summary_body() {
  printf '{"hook_event_name":"%s","cwd":"%s","summary":"%s"}' \
    "$(json_escape "$1")" \
    "$(json_escape "$PWD")" \
    "$(json_escape "$2")"
}

self_check() {
  local out
  out="$(attach_body)"
  case "$out" in
    *'"hook_event_name":"Notification"'*) ;;
    *) echo "FAIL: missing hook_event_name in: $out" >&2; exit 1 ;;
  esac
  case "$out" in
    *"$(json_escape "$PWD")"*) ;;
    *) echo "FAIL: cwd not embedded in: $out" >&2; exit 1 ;;
  esac

  # A Windows path's backslashes must be escaped so the request JSON does not
  # inject control characters (a raw "\r" parses to a carriage return).
  local hatch
  hatch="$(hatch_body "cato" "Rex" "playful" 'C:\a\b')"
  case "$hatch" in
    *'\\a\\b'*) ;;
    *) echo "FAIL: hatch path not escaped: $hatch" >&2; exit 1 ;;
  esac

  local summary
  summary="$(summary_body "Stop" 'He said "hi" and left')"
  case "$summary" in
    *'"hook_event_name":"Stop"'*) ;;
    *) echo "FAIL: missing hook_event_name in: $summary" >&2; exit 1 ;;
  esac
  case "$summary" in
    *'\"hi\"'*) ;;
    *) echo "FAIL: summary text not escaped: $summary" >&2; exit 1 ;;
  esac

  echo "self-check passed"
  exit 0
}

case "$1" in
  --self-check) self_check ;;
  attach) post "$(attach_body)" ;;
  hatch)
    # Authoritative create: show the response and propagate connection failure
    # so the agent can report "app not running" vs. a rejection (e.g. occupied).
    # JSON is built here from plain args so the agent never has to escape a path.
    shift
    curl -sS -m 5 -X POST "$HATCH_URL" \
      -H "Content-Type: application/json" --data-binary "$(hatch_body "$@")"
    exit $?
    ;;
  summary)
    shift
    post "$(summary_body "$@")"
    ;;
  *) post "$(cat)" ;;
esac

exit 0
